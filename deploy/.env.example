# Production settings for deploy/compose.yaml. On the server: cp .env.example .env, then fill in.
# The app variables are those of the root .env.example; compose.yaml sets DATABASE_URL, NODE_ENV,
# PORT, LOG_FORMAT and TZ itself.

# Password of the compose PostgreSQL. Hex only, because it goes into a URL: openssl rand -hex 24
POSTGRES_PASSWORD=

# fatal,error,warn,log (add debug while troubleshooting)
LOG_LEVELS=fatal,error,warn,log

# Moving the local database here: the SAME key as in your local .env, or the stored tokens
# cannot be decrypted. Starting with an empty database: openssl rand -base64 32
ENCRYPTION_KEY=

# The bot token from @BotFather. Only one process may poll a bot: stop the local CalSync first.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_POLLING_ENABLED=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# localhost is reached through an SSH tunnel to the server (README.md, "Подключение Google")
GOOGLE_REDIRECT_URL=http://localhost:3100/auth/google/callback

SYNC_SCHEDULER_ENABLED=true
SYNC_INTERVAL_MINUTES=15
SYNC_WINDOW_PAST_DAYS=7
SYNC_WINDOW_FUTURE_DAYS=60

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
