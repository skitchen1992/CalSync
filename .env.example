# Copy to .env and adjust. Every variable here is declared in src/config/env.schema.ts.

# development | production | test
NODE_ENV=development
# HTTP port (OAuth callback, Telegram webhook, /health)
PORT=3000
# pretty for local work, json for production log collectors
LOG_FORMAT=pretty
# Comma-separated: fatal,error,warn,log,debug,verbose
LOG_LEVELS=fatal,error,warn,log,debug

# PostgreSQL. Matches docker-compose.yml (host port 5433 to avoid a local server on 5432).
DATABASE_URL=postgres://calsync:calsync@localhost:5433/calsync
