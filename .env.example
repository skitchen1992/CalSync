# Copy to .env and fill in. Every variable here is declared in src/config/env.schema.ts.

# development | production | test
NODE_ENV=development
# HTTP port (Google OAuth callback, /health)
PORT=3000
# pretty for local work, json for production log collectors
LOG_FORMAT=pretty
# Comma-separated: fatal,error,warn,log,debug,verbose
LOG_LEVELS=fatal,error,warn,log,debug

# PostgreSQL. Matches docker-compose.yml (host port 5433 to avoid a local server on 5432).
DATABASE_URL=postgres://calsync:calsync@localhost:5433/calsync
# Encrypts refresh tokens and source URLs at rest. Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot (yours: ask @userinfobot)
TELEGRAM_ALLOWED_USER_IDS=
# Long polling; set to false to run without receiving updates
TELEGRAM_POLLING_ENABLED=true

# Google Cloud OAuth client (type "Web application"), see README
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be listed in the OAuth client's "Authorized redirect URIs"
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google/callback

# Background sync (the dispatcher job); set to false to sync only on /sync
SYNC_SCHEDULER_ENABLED=true
# Minutes between syncs of a source
SYNC_INTERVAL_MINUTES=15
# Days mirrored before and after now
SYNC_WINDOW_PAST_DAYS=7
SYNC_WINDOW_FUTURE_DAYS=60
